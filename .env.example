# GEMINI_API_KEY: Injected by AI Studio. Not used by the app; never expose it to the browser bundle.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Stripe Keys (card payments). Without STRIPE_SECRET_KEY the store can take cash orders only.
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLIC_KEY=
# Recommended: confirms payments even if a customer closes the page (see SETUP.md).
STRIPE_WEBHOOK_SECRET=

# Optional: comma-separated bootstrap admin emails (must match firestore.rules).
# ADMIN_EMAILS=

# Optional: local development against the Firebase emulators (see SETUP.md).
# VITE_USE_FIREBASE_EMULATORS=true
